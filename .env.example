# NatForge configuration. Copy to `.env` (gitignored) or export these.
# The development defaults below match `docker compose up -d`, so for local
# testing you can run the binaries with NO configuration at all.

# --- shared secrets (CHANGE in any real deployment) ---
JWT_SECRET=natforge-dev-secret-change-me
INTERNAL_SECRET=natforge-internal-dev-secret

# --- website_backend (control plane, :3000) ---
PORT=3000
NATFORGE_DOMAIN=natforge.com
CORE_URL=http://127.0.0.1:3001          # fallback only; nodes carry their own internal_url
FRONTEND_DIR=frontend
DATABASE_URL=postgres://natforge:natforge@127.0.0.1:5432/natforge
REDIS_URL=redis://127.0.0.1:6379
# Optional: enable geo-blocking by pointing at a MaxMind GeoLite2-Country.mmdb.
# Unset => country resolution is "unknown" and geo-blocking is a no-op.
# GEOIP_DB=/etc/natforge/GeoLite2-Country.mmdb

# --- core_proxy_backend (data plane node — one per region) ---
CORE_INTERNAL_PORT=3001
CORE_CONTROL_PORT=4000
# Dev uses unprivileged 8080/8443; production uses 80/443 (run as root).
HTTP_PORT=8080
HTTPS_PORT=8443
PUBLIC_HOST=natforge.com                # wildcard apex this node serves
NODE_ID=edge-1                          # unique per node (region key)
NODE_NAME=Local                         # display name in the admin panel
# NODE_REGION=Germany                   # optional human region label
# CONTROL_ENDPOINT=natforge.com:4000    # host:port agents connect to (defaults to PUBLIC_HOST:4000)
# INTERNAL_URL=http://127.0.0.1:3001    # how the website reaches THIS node
PUBLIC_PORT_MIN=20000                   # this node's TCP port pool (seeded on self-register)
PUBLIC_PORT_MAX=20100
WEBSITE_URL=http://127.0.0.1:3000
# GEOIP_DB=/etc/natforge/GeoLite2-Country.mmdb
CF_API_TOKEN=mock_token
CF_ZONE_ID=mock_zone
